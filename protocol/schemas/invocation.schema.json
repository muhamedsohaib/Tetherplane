{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tetherplane.dev/schemas/invocation.schema.json",
  "title": "InvocationEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "request_id",
    "device_id",
    "capability",
    "arguments",
    "actor",
    "session_id",
    "response_mode",
    "idempotency_key",
    "preconditions",
    "expectations"
  ],
  "properties": {
    "protocol_version": { "type": "string", "const": "1.0" },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },    "device_id": { "type": ["string", "null"] },
    "capability": { "type": "string", "minLength": 3 },
    "arguments": { "type": "object" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["human", "ai_client", "system"]
        }
      }
    },
    "session_id": { "type": ["string", "null"] },
    "response_mode": {
      "type": "string",
      "enum": ["compact", "normal", "debug"]
    },
    "idempotency_key": { "type": ["string", "null"] },
    "preconditions": {
      "type": "array",
      "items": { "type": "object" }
    },    "expectations": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}

