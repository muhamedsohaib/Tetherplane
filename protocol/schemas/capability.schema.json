{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tetherplane.dev/schemas/capability.schema.json",
  "title": "CapabilityDescriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version","capability","available","provider","input_schema","reason"],
  "properties": {
    "protocol_version": { "type": "string", "const": "1.0" },
    "capability": { "type": "string", "minLength": 3 },
    "available": { "type": "boolean" },
    "provider": { "type": ["string", "null"] },
    "input_schema": { "type": ["object", "null"] },
    "reason": { "type": ["string", "null"] }
  }
}
