{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://tetherplane.dev/schemas/result.schema.json",
  "title": "ResultEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version","request_id","status","data","delta","error","verification","continuation","policy","timing"],
  "properties": {
    "protocol_version": { "type": "string", "const": "1.0" },
    "request_id": { "type": "string", "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$" },
    "status": { "type": "string", "enum": ["success", "error"] },
    "data": { "type": ["object", "null"] },
    "delta": { "type": ["object", "null"] },
    "error": { "anyOf": [{ "$ref": "error.schema.json" }, { "type": "null" }] },
    "verification": { "type": "string", "enum": ["not_applicable", "verified", "executed_unverified", "failed"] },
    "continuation": { "type": ["object", "null"] },
    "policy": { "type": ["object", "null"] },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms"],
      "properties": { "duration_ms": { "type": "integer", "minimum": 0 } }
    }
  }
}
