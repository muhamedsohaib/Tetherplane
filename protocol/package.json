{
  "name": "@tetherplane/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./generated/types.d.ts",
  "exports": {
    ".": {
      "types": "./generated/types.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/error.schema.json": "./schemas/error.schema.json",
    "./schemas/result.schema.json": "./schemas/result.schema.json"
  },
  "scripts": {
    "build": "node scripts/generate-types.mjs && tsc -p tsconfig.json",
    "test": "node --test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "json-schema-to-typescript": "15.0.4"
  }
}
