{
  "name": "@tetherplane/control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretypecheck": "pnpm --filter @tetherplane/relay build",
    "typecheck": "tsc -p tsconfig.test.json",
    "pretest": "pnpm --filter @tetherplane/relay build",
    "test": "node --test test/*.test.ts",
    "test:browser": "playwright test",
    "start": "node dist/cli.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tetherplane/relay": "workspace:*",
    "@types/node": "24.13.6"
  }
}
