{
    "name":  "@tetherplane/browser-extension",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "scripts":  {
                    "pretest":  "pnpm run build",
                    "build":  "tsc -p tsconfig.json --noEmit \u0026\u0026 esbuild src/background.ts src/pair.ts --bundle --platform=browser --format=esm --target=chrome120 --outdir=dist",
                    "test":  "node --test test/*.test.ts",
                    "typecheck":  "pnpm --filter @tetherplane/browser-bridge build \u0026\u0026 tsc -p tsconfig.test.json",
                    "prebuild":  "pnpm --filter @tetherplane/browser-bridge build"
                },
    "dependencies":  {
                         "@tetherplane/browser-bridge":  "workspace:*"
                     },
    "devDependencies":  {
                            "@types/chrome":  "0.3.0",
                            "@types/node":  "24.13.6",
                            "esbuild":  "0.25.10"
                        }
}
