{
  "name": "@tetherplane/relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "tether-relay": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @tetherplane/compact-mcp build",
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm --filter @tetherplane/compact-mcp build",
    "test": "node --test test/*.test.ts",
    "pretypecheck": "pnpm --filter @tetherplane/compact-mcp build",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@tetherplane/compact-mcp": "workspace:*",
    "@tetherplane/protocol": "workspace:*",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/ws": "8.18.1"
  }
}
