FROM node:22-bookworm-slim AS build

WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@10.34.5 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY protocol ./protocol
COPY adapters/compact-mcp ./adapters/compact-mcp
COPY relay ./relay

RUN pnpm install --frozen-lockfile
RUN pnpm --filter @tetherplane/protocol build \
 && pnpm --filter @tetherplane/compact-mcp build \
 && pnpm --filter @tetherplane/relay build

FROM node:22-bookworm-slim AS runtime

ENV NODE_ENV=production
WORKDIR /app

RUN groupadd --system tetherplane \
 && useradd --system --gid tetherplane --home-dir /app --shell /usr/sbin/nologin tetherplane

COPY --from=build --chown=tetherplane:tetherplane /workspace /app

USER tetherplane
EXPOSE 8788

ENTRYPOINT ["node", "relay/dist/cli.js"]
